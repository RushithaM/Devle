{
  "name": "devle-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:engine": "npm run build --workspace=@devle/engine",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "test": "npm run build:engine && npm test --workspace=@devle/engine && npm test --workspace=frontend && npm test --workspace=backend",
    "content:export": "npm run content:export --workspace=backend"
  }
}
